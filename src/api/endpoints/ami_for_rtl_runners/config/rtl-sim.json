{
  "environment": {
    "CHIPYARD_DIR": "/opt/chipyard",
    "PATH": "/opt/riscv/bin:/opt/verilator/bin:$PATH",
    "RISCV": "/opt/riscv",
    "VERILATOR_ROOT": "/opt/verilator"
  },
  "instance": {
    "ami_base": "ubuntu-24.04-amd64",
    "disk_iops": 3000,
    "disk_size_gb": 100,
    "disk_throughput": 125,
    "disk_type": "gp3",
    "type": "c8i.4xlarge"
  },
  "packages": [
    "autoconf",
    "automake",
    "autotools-dev",
    "bc",
    "bison",
    "build-essential",
    "cmake",
    "curl",
    "device-tree-compiler",
    "flex",
    "gawk",
    "git",
    "gperf",
    "libexpat-dev",
    "libfdt-dev",
    "libglib2.0-dev",
    "libgmp-dev",
    "libmpc-dev",
    "libmpfr-dev",
    "libpixman-1-dev",
    "libtool",
    "ninja-build",
    "openjdk-17-jdk",
    "patchutils",
    "python3",
    "python3-pip",
    "python3-venv",
    "sbt",
    "scala",
    "texinfo",
    "wget",
    "zlib1g-dev"
  ],
  "runner": {
    "group": "rtl-runners",
    "user": "github-runner",
    "version": "2.321.0"
  },
  "tools": {
    "chipyard": {
      "install_path": "/opt/chipyard",
      "version": "1.11.0"
    },
    "riscv_toolchain": {
      "install_path": "/opt/riscv",
      "version": "2024.04.12"
    },
    "verilator": {
      "install_path": "/opt/verilator",
      "version": "5.024"
    }
  }
}