{
  "environment": {
    "CUDA_HOME": "/usr/local/cuda",
    "LD_LIBRARY_PATH": "/usr/local/cuda/lib64:$LD_LIBRARY_PATH",
    "PATH": "/usr/local/cuda/bin:/opt/rtlflow/bin:/opt/verilator/bin:$PATH"
  },
  "instance": {
    "ami_base": "nvidia-cuda-ubuntu-24.04",
    "disk_iops": 3000,
    "disk_size_gb": 100,
    "disk_throughput": 125,
    "disk_type": "gp3",
    "type": "g6e.xlarge"
  },
  "nvidia": {
    "cuda_version": "12.4",
    "cudnn_version": "8.9",
    "driver_version": "550"
  },
  "packages": [
    "build-essential",
    "cmake",
    "curl",
    "git",
    "libboost-all-dev",
    "ninja-build",
    "nvidia-cuda-dev",
    "nvidia-cuda-toolkit",
    "python3",
    "python3-pip",
    "python3-venv",
    "wget"
  ],
  "runner": {
    "group": "rtl-runners",
    "user": "github-runner",
    "version": "2.321.0"
  },
  "tools": {
    "cuda": {
      "install_path": "/usr/local/cuda",
      "version": "12.4"
    },
    "rtlflow": {
      "install_path": "/opt/rtlflow",
      "repository": "https://github.com/dian-lun-lin/RTLflow",
      "version": "main"
    },
    "verilator": {
      "install_path": "/opt/verilator",
      "version": "5.024"
    }
  }
}