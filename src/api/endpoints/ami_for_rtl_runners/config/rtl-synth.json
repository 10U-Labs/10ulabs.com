{
  "environment": {
    "OPENLANE_ROOT": "/opt/openlane",
    "PATH": "/opt/openlane:/opt/magic/bin:/opt/klayout:/opt/yosys/bin:/opt/openroad/bin:$PATH",
    "PDK": "sky130A",
    "PDK_ROOT": "/opt/pdk"
  },
  "instance": {
    "ami_base": "ubuntu-24.04-amd64",
    "disk_iops": 4000,
    "disk_size_gb": 200,
    "disk_throughput": 250,
    "disk_type": "gp3",
    "type": "r8i.4xlarge"
  },
  "packages": [
    "bison",
    "build-essential",
    "clang",
    "cmake",
    "curl",
    "flex",
    "git",
    "graphviz",
    "libboost-all-dev",
    "libcairo2-dev",
    "libffi-dev",
    "libncurses-dev",
    "libreadline-dev",
    "libx11-dev",
    "libxext-dev",
    "libxft-dev",
    "libxpm-dev",
    "ninja-build",
    "python3",
    "python3-pip",
    "python3-venv",
    "swig",
    "tcl",
    "tcl-dev",
    "tk",
    "tk-dev",
    "wget",
    "xdot"
  ],
  "runner": {
    "group": "rtl-runners",
    "user": "github-runner",
    "version": "2.321.0"
  },
  "tools": {
    "klayout": {
      "install_path": "/opt/klayout",
      "version": "0.29.0"
    },
    "magic": {
      "install_path": "/opt/magic",
      "version": "8.3.468"
    },
    "openlane": {
      "install_path": "/opt/openlane",
      "version": "2.1.0"
    },
    "openroad": {
      "install_path": "/opt/openroad",
      "version": "2.0"
    },
    "sky130_pdk": {
      "install_path": "/opt/pdk/sky130",
      "version": "1.0.457"
    },
    "yosys": {
      "install_path": "/opt/yosys",
      "version": "0.40"
    }
  }
}