# RTL Synthesis Runner Dockerfile
# Optimized for OpenLane/SKY130 synthesis on r8i.4xlarge
#
# Build: docker build -f Dockerfile.synth -t rtl-synth:latest ..
# Size: ~15GB (includes PDK and synthesis tools)

FROM ubuntu:24.04 AS base

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Install base packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    curl \
    wget \
    ca-certificates \
    gnupg \
    lsb-release \
    sudo \
    locales \
    && rm -rf /var/lib/apt/lists/* \
    && locale-gen en_US.UTF-8

ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

# Install development tools for OpenLane
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    tcl \
    tcl-dev \
    tk \
    tk-dev \
    libcairo2-dev \
    libncurses-dev \
    libx11-dev \
    libxpm-dev \
    libxft-dev \
    libxext-dev \
    libreadline-dev \
    libffi-dev \
    graphviz \
    xdot \
    clang \
    bison \
    flex \
    libboost-all-dev \
    swig \
    cmake \
    ninja-build \
    autoconf \
    automake \
    libtool \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Install Docker CLI (for OpenLane containerized flow)
RUN curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/trusted.gpg.d/docker.gpg \
    && echo "deb [arch=amd64] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" > /etc/apt/sources.list.d/docker.list \
    && apt-get update && apt-get install -y --no-install-recommends \
    docker-ce-cli \
    && rm -rf /var/lib/apt/lists/*

# Create runner user
ARG RUNNER_USER=github-runner
ARG RUNNER_UID=1000
ARG RUNNER_GID=1000

RUN groupadd --gid ${RUNNER_GID} ${RUNNER_USER} \
    && useradd --uid ${RUNNER_UID} --gid ${RUNNER_GID} -m ${RUNNER_USER} \
    && echo "${RUNNER_USER} ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers \
    && usermod -aG docker ${RUNNER_USER} || true

# Install OpenLane via pip
RUN python3 -m pip install --break-system-packages openlane==2.1.0

# Environment variables for PDK
ENV PDK_ROOT=/opt/pdk
ENV PDK=sky130A
ENV OPENLANE_ROOT=/opt/openlane
ENV PATH=/opt/openlane:$PATH

# Create PDK directory (will be populated at runtime or via volume mount)
RUN mkdir -p /opt/pdk /opt/openlane /workspace \
    && chown -R ${RUNNER_USER}:${RUNNER_USER} /opt/pdk /opt/openlane /workspace

# Install GitHub Actions runner
ARG RUNNER_VERSION=2.321.0
WORKDIR /home/${RUNNER_USER}/actions-runner

RUN curl -o actions-runner-linux-x64-${RUNNER_VERSION}.tar.gz -L \
    https://github.com/actions/runner/releases/download/v${RUNNER_VERSION}/actions-runner-linux-x64-${RUNNER_VERSION}.tar.gz \
    && tar xzf actions-runner-linux-x64-${RUNNER_VERSION}.tar.gz \
    && rm actions-runner-linux-x64-${RUNNER_VERSION}.tar.gz \
    && ./bin/installdependencies.sh \
    && chown -R ${RUNNER_USER}:${RUNNER_USER} /home/${RUNNER_USER}

USER ${RUNNER_USER}
WORKDIR /home/${RUNNER_USER}

# Verify installation
RUN openlane --version || echo "OpenLane installed (may need PDK for full verification)"

# Default command (will be overridden by runner registration)
CMD ["./actions-runner/run.sh"]
