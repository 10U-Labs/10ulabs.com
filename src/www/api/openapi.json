    "/v1/github-workflows/webhooks/circuit-opens": {
      "get": {
        "summary": "Get Circuit Opens Status",
        "description": "Returns the current status of the github workflows webhook circuit opens including DynamoDB state, SQS event source state, and Lambda concurrency",
        "operationId": "getGithubWorkflowsCircuitOpensStatus",
        "tags": [
          "/v1/github-workflows"
        ],
        "security": [
          {
            "api_key": []
          }
        ],
        "responses": {
          "200": {
            "description": "Circuit opens is healthy (closed state)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "healthy",
                    "state",
                    "sqs_event_source",
                    "reserved_concurrency"
                  ],
                  "properties": {
                    "healthy": {
                      "type": "boolean",
                      "example": true
                    },
                    "state": {
                      "type": "string",
                      "example": "closed"
                    },
                    "sqs_event_source": {
                      "type": "string",
                      "example": "Enabled"
                    },
                    "reserved_concurrency": {
                      "type": "integer",
                      "nullable": true,
                      "example": null
                    },
                    "last_failure_time": {
                      "type": "integer",
                      "example": 0
                    },
                    "recovery_attempts": {
                      "type": "integer",
                      "example": 0
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Circuit opens is unhealthy (open or half-open state)",
