{
  "aws": {
    "account_id": 781581267945,
    "region": "us-east-1"
  },


  "vpc": {
    "cidr": "10.0.0.0/16",
    "nat_gateways": 0,
    "subnet_configuration": {
      "public_subnet_cidr_mask": 24
    }
  },
  "naming": {
    "vpc_name": "github-runners-vpc",
    "cluster_name": "github-runners-cluster",
    "task_family": "github-ephemeral-runner",
    "container_name": "github-runner",
    "log_stream_prefix": "github-runner",
    "lambda_function_name": "github-runner_webhook-handler",
    "api_gateway_name": "github-runner_webhook",
    "github_token_secret_name": "github-runner/credentials",
    "webhook_secret_name": "github-webhook-secret"
  },
  "lambda": {
    "timeout_seconds": 30,
    "memory_mb": 256
  },
  "base_os": {
    "os": "debian",
    "version": "stable",
    "variant": "slim",
    "architecture": "arm64"
  },
  "github": {
    "runner_version": "2.311.0",
    "repo": "10U-Foundation/10uf.org"
  },
  "docker_builder": {
    "enabled": true,
    "instance_type": "t4g.large",
    "spot_instance": true,
    "spot_instance_types": ["t4g.large", "t4g.medium", "t4g.small", "t4g.micro", "t4g.nano"],
    "spot_max_price": 0.05,
    "spot_retry_attempts": 5,
    "spot_retry_delay": 30,
    "custom_ami_id": "",
    "storage": {
      "volume_size": 100,
      "volume_type": "gp3"
    },
    "runner_labels": [
      "docker-builder",
      "ephemeral-ec2-spot-instance",
      "arm64"
    ],
    "max_instances": 2,
    "stack_name": "github-runner-docker-builder"
  },
  "fargate_runners": {
    "enabled": true,
    "cpu": 512,
    "memory": 1024,
    "spot_instance": true,
    "spot_weight": 100,
    "ondemand_base": 0,
    "runner_labels": [
      "ephemeral-ecs-fargate-spot",
      "general"
    ],
    "min_instances": 0,
    "max_instances": 10,
    "desired_count": 0,
    "scaling": {
      "target_cpu_utilization": 70,
      "target_memory_utilization": 80,
      "scale_in_cooldown": 300,
      "scale_out_cooldown": 60
    },
    "stack_name": "github-runner-fargate",
    "ecr_repository": "github-runner-fargate",
    "log_retention_days": 7
  }
}