{
  "api_backend": {
    "depends_on": [
      "www_shared"
    ],
    "name": "Ensuring API backend exists and is properly configured",
    "paths": [
      ".github/workflows/api_backend.yml",
      "src/api/backend/**",
      "src/www/api/**",
      "test/api/backend/**",
      "test/api/conftest.py"
    ]
  },
  "api_shared_ecs_runner": {
    "depends_on": [
      "endpoint_v1_ec2_runner"
    ],
    "name": "Deploying API Shared ECS Runner Infrastructure",
    "paths": [
      ".github/workflows/api_shared_ecs_runner.yml",
      "src/api/shared/ecs_runner/**",
      "test/api/shared/ecs_runner/**"
    ]
  },
  "api_shared_runners": {
    "depends_on": [
      "operational_health"
    ],
    "name": "Deploying API Shared Runners Infrastructure",
    "paths": [
      ".github/workflows/api_shared_runners.yml",
      "src/api/shared/runners/**",
      "test/api/shared/runners/**"
    ]
  },
  "bootstrap": {
    "depends_on": [],
    "name": "Ensuring bootstrap infrastructure exists and is properly configured",
    "paths": [
      ".github/workflows/bootstrap.yml",
      "etc/workflow-dependencies.json",
      "lib/python/terraform_config/**",
      "lib/terraform/**",
      "src/bootstrap/**",
      "test/bootstrap/**"
    ]
  },
  "endpoint_v1_contact": {
    "depends_on": [
      "endpoint_v1_echo"
    ],
    "name": "Ensuring /v1/contact API endpoint exists and is properly configured",
    "paths": [
      ".github/workflows/endpoint_v1_contact.yml",
      "src/api/endpoints/contact/**",
      "test/api/endpoints/contact/**"
    ]
  },
  "endpoint_v1_ec2_runner": {
    "depends_on": [
      "endpoint_v1_image_for_ec2_runners"
    ],
    "name": "Ensuring the /v1/ec2-runner API endpoint exists and is properly configured",
    "paths": [
      ".github/workflows/endpoint_v1_ec2_runner.yml",
      "src/api/endpoints/ec2_runner/**",
      "test/api/conftest.py",
      "test/api/endpoints/ec2_runner/**"
    ]
  },
  "endpoint_v1_echo": {
    "depends_on": [
      "endpoint_v1_runners"
    ],
    "name": "Ensuring /v1/echo API endpoint exists and is properly configured",
    "paths": [
      ".github/workflows/endpoint_v1_echo.yml",
      "src/api/endpoints/echo/**",
      "test/api/endpoints/echo/**"
    ]
  },
  "endpoint_v1_ecs_runner": {
    "depends_on": [
      "endpoint_v1_image_for_ecs_runners"
    ],
    "name": "Ensuring the /v1/ecs-runner API endpoint exists and is properly configured",
    "paths": [
      ".github/workflows/endpoint_v1_ecs_runner.yml",
      "src/api/endpoints/ecs_runner/**",
      "test/api/conftest.py",
      "test/api/endpoints/ecs_runner/**"
    ]
  },
  "endpoint_v1_image_for_ec2_runners": {
    "depends_on": [
      "api_shared_runners"
    ],
    "name": "Ensuring /v1/image-for-ec2-runners API endpoint exists and is properly configured",
    "paths": [
      ".github/workflows/endpoint_v1_image_for_ec2_runners.yml",
      "src/api/endpoints/image_for_ec2_runners/*.tf",
      "src/api/endpoints/image_for_ec2_runners/lambda/**",
      "test/api/endpoints/image_for_ec2_runners/endpoint/**"
    ]
  },
  "endpoint_v1_image_for_ec2_runners_post": {
    "depends_on": [],
    "name": "Building AMI for EC2 self-hosted runners",
    "paths": [
      ".github/workflows/endpoint_v1_image_for_ec2_runners_post.yml",
      "lib/python/ec2_fleet/**",
      "src/api/endpoints/image_for_ec2_runners/post/**",
      "test/api/endpoints/image_for_ec2_runners/post/**"
    ]
  },
  "endpoint_v1_image_for_ecs_runners": {
    "depends_on": [
      "api_shared_ecs_runner"
    ],
    "name": "Ensuring /v1/image-for-ecs-runners API endpoint exists and is properly configured",
    "paths": [
      ".github/workflows/endpoint_v1_image_for_ecs_runners.yml",
      "src/api/endpoints/image_for_ecs_runners/lambda/**",
      "src/api/endpoints/image_for_ecs_runners/*.tf",
      "test/api/endpoints/image_for_ecs_runners/endpoint/**"
    ]
  },
  "endpoint_v1_image_for_ecs_runners_post": {
    "depends_on": [],
    "name": "Building Docker image for ECS runners",
    "paths": [
      ".github/workflows/endpoint_v1_image_for_ecs_runners_post.yml",
      "src/api/endpoints/image_for_ecs_runners/post/**",
      "test/api/endpoints/image_for_ecs_runners/post/**"
    ]
  },
  "endpoint_v1_rack_designer": {
    "depends_on": [
      "www_index"
    ],
    "name": "Ensuring /v1/rack-designer API endpoint exists and is properly configured",
    "paths": [
      ".github/workflows/endpoint_v1_rack_designer.yml",
      "src/api/endpoints/rack_designer/**",
      "src/www/paths/rack_designer/**",
      "test/api/endpoints/rack_designer/**"
    ]
  },
  "endpoint_v1_runners": {
    "depends_on": [
      "endpoint_v1_ecs_runner"
    ],
    "name": "Ensuring the /v1/runners API endpoint exists and is properly configured",
    "paths": [
      ".github/workflows/endpoint_v1_runners.yml",
      "etc/runners.json",
      "lib/python/runner_labels/**",
      "src/api/endpoints/runners/**",
      "test/api/conftest.py",
      "test/api/endpoints/runners/**"
    ]
  },
  "endpoint_v1_simulation_soc": {
    "depends_on": [
      "endpoint_v1_rack_designer"
    ],
    "name": "Ensuring the /v1/simulation-soc API endpoint exists and is properly configured",
    "paths": [
      ".github/workflows/endpoint_v1_simulation_soc.yml",
      "src/api/endpoints/simulation_soc/**",
      "src/www/paths/simulations/soc/**",
      "test/api/endpoints/simulation_soc/**"
    ]
  },
  "operational_health": {
    "depends_on": [
      "api_backend"
    ],
    "name": "Ensuring operational health endpoint exists and is properly configured",
    "paths": [
      ".github/workflows/operational_health.yml",
      "src/api/operational/health/**",
      "test/api/operational/health/**"
    ]
  },
  "www_index": {
    "depends_on": [
      "endpoint_v1_contact"
    ],
    "name": "Ensuring www index (home page) exists and is properly configured",
    "paths": [
      ".github/workflows/www_index.yml",
      "src/www/paths/index/**",
      "test/www/paths/index/**"
    ]
  },
  "www_shared": {
    "depends_on": [
      "bootstrap"
    ],
    "name": "Ensuring www shared infrastructure exists and is properly configured",
    "paths": [
      ".github/workflows/www_shared.yml",
      "src/www/shared/**",
      "test/www/shared/**"
    ]
  }
}
