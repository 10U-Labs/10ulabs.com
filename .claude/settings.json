{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/bash_command_blocker.py",
            "timeout": 300
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/pre_git_checks.py",
            "timeout": 300
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/file_creation_blocker.py",
            "timeout": 300
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/lint_disable_blocker.py",
            "timeout": 300
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/s3_versioning_checker.py",
            "timeout": 300
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/code_quality_checker.py",
            "timeout": 300
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/test_standards_checker.py",
            "timeout": 300
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/lint_disable_blocker.py",
            "timeout": 300
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/s3_versioning_checker.py",
            "timeout": 300
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/code_quality_checker.py",
            "timeout": 300
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/test_standards_checker.py",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
