#!/usr/bin/env python3
import fnmatch
import re
import subprocess
import sys
from pathlib import Path

import yaml


def get_staged_files():
    result = subprocess.run(
        ['git', 'diff', '--cached', '--name-only', '--diff-filter=ACM'],
        capture_output=True, text=True
    )
    files = result.stdout.strip().split('\n') if result.stdout.strip() else []
    return [f for f in files if f]


def path_matches_pattern(file_path, pattern):
    if pattern.endswith('/**'):
        prefix = pattern[:-3]
        return file_path.startswith(prefix)
    if '**' in pattern:
        regex = pattern.replace('.', r'\.').replace('**', '.*').replace('*', '[^/]*')
        return bool(re.match(f'^{regex}$', file_path))
    return fnmatch.fnmatch(file_path, pattern)


def get_workflow_paths(workflow):
    paths = []
    on_section = workflow.get('on') or workflow.get(True) or {}
    if isinstance(on_section, dict):
        push_section = on_section.get('push', {})
        if isinstance(push_section, dict):
            paths = push_section.get('paths', [])
    return paths


def find_matching_workflows(changed_files, workflows_dir):
    matching = {}
    workflow_files = list(Path(workflows_dir).glob('*.yml'))
    for wf_path in workflow_files:
        with open(wf_path) as f:
            try:
                workflow = yaml.safe_load(f)
            except yaml.YAMLError:
                continue
        if not workflow:
            continue
        paths = get_workflow_paths(workflow)
        if not paths:
            continue
        for changed_file in changed_files:
            for pattern in paths:
                if path_matches_pattern(changed_file, pattern):
                    matching[wf_path.stem] = workflow
    return matching


def is_static_analysis_job(job_name):
    job_lower = job_name.lower().replace('-', '_').replace(' ', '_')
    return 'static' in job_lower or 'analysis' in job_lower or 'lint' in job_lower


def is_pre_push_check_step(step_name, run_cmd):
    step_lower = step_name.lower()
    static_keywords = [
        'lint', 'pylint', 'mypy', 'type check', 'static',
        'format check', 'fmt', 'validate', 'hadolint', 'tflint',
        'yamllint', 'jsonlint'
    ]
    if any(kw in step_lower for kw in static_keywords):
        return True
    return False


def is_conditional_on_github_hosted(condition):
    if not condition:
        return False
    return 'github_hosted' in condition or 'github-hosted' in condition


def clean_script(raw_cmd):
    cleaned = re.sub(r'\$\{\{[^}]+\}\}', '', raw_cmd)
    lines = []
    for line in cleaned.split('\n'):
        if line.strip() and not line.strip().startswith('#'):
            lines.append(line)
    return '\n'.join(lines)


def extract_static_analysis_commands(workflow):
    commands = []
    jobs = workflow.get('jobs', {})
    for job_name, job in jobs.items():
        if not is_static_analysis_job(job_name):
            continue
        steps = job.get('steps', [])
        for step in steps:
            step_name = step.get('name', '')
            run_cmd = step.get('run', '')
            if not run_cmd:
                continue
            if not is_pre_push_check_step(step_name, run_cmd):
                continue
            condition = step.get('if', '')
            commands.append({
                'name': step_name or 'unnamed',
                'run': run_cmd,
                'conditional': is_conditional_on_github_hosted(condition),
                'job': job_name
            })
    return commands


def run_command(cmd_info, workflow_name):
    if cmd_info.get('conditional'):
        print(f"  [SKIP] {cmd_info['name']} (conditional on github-hosted)")
        return True

    name = cmd_info['name']
    raw_cmd = cmd_info['run']
    script = clean_script(raw_cmd)

    if not script.strip():
        return True

    print(f"  [{workflow_name}] {name}...", end=' ', flush=True)

    result = subprocess.run(
        script,
        shell=True,
        capture_output=True,
        text=True,
        executable='/bin/bash'
    )

    if result.returncode != 0:
        print("FAILED")
        if result.stdout:
            for line in result.stdout.strip().split('\n')[-15:]:
                print(f"    {line}")
        if result.stderr:
            for line in result.stderr.strip().split('\n')[-10:]:
                print(f"    {line}")
        return False

    print("OK")
    return True


def main():
    staged_files = get_staged_files()
    if not staged_files:
        sys.exit(0)

    repo_root = subprocess.run(
        ['git', 'rev-parse', '--show-toplevel'],
        capture_output=True, text=True
    ).stdout.strip()

    workflows_dir = Path(repo_root) / '.github' / 'workflows'
    if not workflows_dir.exists():
        sys.exit(0)

    matching_workflows = find_matching_workflows(staged_files, workflows_dir)

    if not matching_workflows:
        sys.exit(0)

    print(f"Pre-commit: checking {len(staged_files)} staged files")
    print(f"Matching workflows: {list(matching_workflows.keys())}")

    all_passed = True
    for wf_name, workflow in matching_workflows.items():
        commands = extract_static_analysis_commands(workflow)
        for cmd_info in commands:
            if not run_command(cmd_info, wf_name):
                all_passed = False

    if not all_passed:
        print("\nPre-commit checks FAILED. Fix issues before committing.")
        sys.exit(1)

    print("\nPre-commit checks passed.")
    sys.exit(0)


if __name__ == '__main__':
    main()
